{
  "name": "sap-technologies-ug",
  "version": "1.0.0",
  "private": true,
  "description": "SAP Technologies Uganda client and server",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "npm --prefix sap-technologies-official run dev",
    "dev:server": "npm --prefix server run dev",
    "build": "npm run build:client && npm run build:server",
    "build:client": "npm --prefix sap-technologies-official run build",
    "build:server": "npm --prefix server run build",
    "lint:client": "npm --prefix sap-technologies-official run lint",
    "install:client": "npm ci --prefix sap-technologies-official",
    "install:server": "npm ci --prefix server",
    "install:all": "npm run install:client && npm run install:server",
    "vercel-build": "npm run build:client",
    "db:migrate:test-to-sap": "npm --prefix server run db:migrate:test-to-sap",
    "db:migrate:test-to-sap:dry-run": "npm --prefix server run db:migrate:test-to-sap:dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0"
  }
}
