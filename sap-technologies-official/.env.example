# API Configuration
# Copy this file to .env.local for local development
# Copy this file to .env.production for production builds

# Backend API URLs
# For local development: leave VITE_API_URL empty to use the Vite proxy.
# For production: point VITE_API_URL to the Coolify API.
VITE_API_URL=https://api.saptechug.com

# Fallback sends browser requests to Render when the Coolify/custom API is down.
VITE_ENABLE_API_FALLBACK=true

# Render fallback API. Keep Render on the same code/env/database for real failover.
VITE_API_FALLBACK_URL=https://sap-technologies-ug.onrender.com

# Optional: comma-separated fallback API priority list. Only used when
# VITE_ENABLE_API_FALLBACK=true.
VITE_API_URLS=

# Browser-level connection failures can fall back to Render for all requests.
# Keep this false unless you also want retryable HTTP errors such as 502/503
# during write requests to fall back to Render.
VITE_API_FALLBACK_MUTATIONS=true

# Environment
# Options: development, production
VITE_ENV=production

# Advertising
# Default production setup uses the Monetag service worker in public/sw.js.
VITE_AD_PROVIDER=monetag
VITE_AD_DISABLED=false
VITE_AD_ENABLE_IN_DEV=false
VITE_AD_AUTO=true
VITE_MONETAG_MULTITAG_ENABLED=false
# In-Page Push is a single page-level native banner. It must not be configured
# as a product-inline slot because its tag is not an inline creative.
VITE_MONETAG_IN_PAGE_PUSH_ENABLED=false
VITE_MONETAG_IN_PAGE_PUSH_SCRIPT_URL=
VITE_MONETAG_IN_PAGE_PUSH_ZONE_ID=
VITE_MONETAG_VIGNETTE_ENABLED=true
VITE_MONETAG_VIGNETTE_SCRIPT_URL=https://ekhay.com/vignette.min.js?z=11767559
VITE_MONETAG_CFASYNC=false

# Global provider script and zone for network-managed formats. Monetag's
# MultiTag is not used in visual placements because it can make an empty area
# clickable; configure each visual banner/native placement separately below.
VITE_AD_SCRIPT_URL=https://quge5.com/88/tag.min.js
VITE_AD_SDK_NAME=
VITE_AD_DIRECT_LINK_URL=
VITE_AD_ROUTE_TRIGGER_FUNCTION=
VITE_AD_ROUTE_TRIGGER_DELAY=900

# Optional banner/native placement scripts by page area. Only configured placements
# are rendered, preventing empty areas from redirecting visitors. A configured slot
# overrides the global script and zone.
VITE_AD_SLOT_HOME_TOP_SCRIPT_URL=
VITE_AD_SLOT_HOME_TOP_ID=
VITE_AD_SLOT_HOME_TOP_WIDTH=970
VITE_AD_SLOT_HOME_TOP_HEIGHT=90
VITE_AD_SLOT_HOME_MIDDLE_SCRIPT_URL=
VITE_AD_SLOT_HOME_MIDDLE_ID=
VITE_AD_SLOT_HOME_MIDDLE_WIDTH=728
VITE_AD_SLOT_HOME_MIDDLE_HEIGHT=90
VITE_AD_SLOT_MARKETPLACE_SCRIPT_URL=
VITE_AD_SLOT_MARKETPLACE_ID=
VITE_AD_SLOT_MARKETPLACE_WIDTH=728
VITE_AD_SLOT_MARKETPLACE_HEIGHT=90
VITE_AD_SLOT_PRODUCT_INLINE_SCRIPT_URL=
VITE_AD_SLOT_PRODUCT_INLINE_ID=
VITE_AD_SLOT_PRODUCT_INLINE_WIDTH=970
VITE_AD_SLOT_PRODUCT_INLINE_HEIGHT=90
VITE_AD_SLOT_PAGE_TOP_SCRIPT_URL=
VITE_AD_SLOT_PAGE_TOP_ID=
VITE_AD_SLOT_PAGE_TOP_WIDTH=970
VITE_AD_SLOT_PAGE_TOP_HEIGHT=90
VITE_AD_SLOT_PAGE_BOTTOM_SCRIPT_URL=
VITE_AD_SLOT_PAGE_BOTTOM_ID=
VITE_AD_SLOT_PAGE_BOTTOM_WIDTH=728
VITE_AD_SLOT_PAGE_BOTTOM_HEIGHT=90
VITE_AD_SLOT_SOFTWARE_SCRIPT_URL=
VITE_AD_SLOT_SOFTWARE_ID=
VITE_AD_SLOT_SOFTWARE_WIDTH=728
VITE_AD_SLOT_SOFTWARE_HEIGHT=90
VITE_AD_SLOT_IOT_SCRIPT_URL=
VITE_AD_SLOT_IOT_ID=
VITE_AD_SLOT_IOT_WIDTH=728
VITE_AD_SLOT_IOT_HEIGHT=90
